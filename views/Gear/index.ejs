<%- include("../partials/layout/top", { title }) %>

<%- include("../partials/components/page-header", {
  heading: "Gear Catalog",
  subtitle: `${gear.length} item(s)`,
  buttonHref: "/gear/new",
  buttonText: "+ Add Gear",
}) %>

<div class="mb-3">
  <a href="/gear" class="btn btn-sm <%= category ? "btn-outline-secondary" : "btn-secondary" %>">All</a>
  <% categories.forEach((cat) => { %>
    <a href="/gear?category=<%= encodeURIComponent(cat) %>" class="btn btn-sm <%= cat === category ? "btn-secondary" : "btn-outline-secondary" %>"><%= cat %></a>
  <% }) %>
</div>

<% if (gear.length === 0) { %>
  <%- include("../partials/components/empty-state", {
    message: category ? `There's no gear in the ${category} category.` : "The catalog is empty. Add the first item with + Add Gear.",
  }) %>
<% } else { %>
<div class="table-responsive">
  <table class="table table-hover align-middle bg-white shadow-sm">
    <thead class="table-light"><tr><th>Name</th><th>Category</th><th>Condition</th><th>Daily fee</th><th>Status</th></tr></thead>
    <tbody>
      <% gear.forEach((item) => { %>
        <tr>
          <td><a href="/gear/<%= item.id %>" class="fw-semibold"><%= item.name %></a></td>
          <td><%= item.category %></td>
          <td><%= item.condition %></td>
          <td>$<%= item.dailyFee.toFixed(2) %></td>
          <td><%- include("../partials/components/status-badge", { available: !checkedOutIds.has(item.id) }) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include("../partials/layout/bottom") %>
