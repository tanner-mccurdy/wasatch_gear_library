<%- include("../partials/layout/top", { title }) %>

<nav class="small mb-2"><a href="/gear">&larr; All gear</a></nav>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h1 class="h3 mb-1"><%= item.name %></h1>
        <p class="text-muted mb-2"><%= item.category %> &middot; <%= item.condition %> condition &middot; $<%= item.dailyFee.toFixed(2) %>/day</p>
        <%- include("../partials/components/status-badge", { available }) %>
      </div>
      <div class="text-end">
        <a href="/gear/<%= item.id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
        <% if (available) { %>
          <a href="/checkouts/new?gearId=<%= item.id %>" class="btn btn-primary btn-sm ms-1">Check out</a>
        <% } %>
      </div>
    </div>
    <% if (item.description) { %>
      <p class="mt-3 mb-0"><%= item.description %></p>
    <% } %>
  </div>
</div>

<h2 class="h5 mb-3">Checkout history</h2>

<%- include("../partials/components/checkout-table", {
  checkouts: history,
  today,
  emptyMessage: "This item has never been checked out.",
}) %>

<%- include("../partials/layout/bottom") %>
