<%- include("../partials/layout/top", { title }) %>

<nav class="small mb-2"><a href="/checkouts">&larr; Checkouts</a></nav>
<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card shadow-sm"><div class="card-body">
      <h1 class="h4 mb-3">Check out gear</h1>

      <% if (availableGear.length === 0) { %>
        <%- include("../partials/components/empty-state", { message: "Every item is checked out right now. Mark something returned first." }) %>
      <% } else { %>
      <form method="POST" action="/checkouts">
        <div class="mb-3">
          <label class="form-label" for="gearId">Gear (available only)</label>
          <select class="form-select" id="gearId" name="gearId" required>
            <option value="">Choose gear...</option>
            <% availableGear.forEach((item) => { %><option value="<%= item.id %>" <%= item.id === form.gearId ? "selected" : "" %>><%= item.name %> ($<%= item.dailyFee.toFixed(2) %>/day)</option><% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="memberId">Member</label>
          <select class="form-select" id="memberId" name="memberId" required>
            <option value="">Choose member...</option>
            <% members.forEach((member) => { %><option value="<%= member.id %>" <%= member.id === form.memberId ? "selected" : "" %>><%= member.getFullName() %></option><% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label" for="dueOn">Due back</label>
          <input class="form-control" type="date" id="dueOn" name="dueOn" value="<%= form.dueOn ?? "" %>" min="<%= today %>" required>
        </div>
        <button class="btn btn-primary w-100">Check out</button>
      </form>
      <% } %>
      <%- include("../partials/components/form-errors", { errors }) %>
    </div></div>
  </div>
</div>

<%- include("../partials/layout/bottom") %>
